<thing:thing-descriptions bindingId="co7io-bacnet"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
  xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

  <channel-type id="eventState">
    <item-type>Number</item-type>
    <label>Event State</label>
    <state>
      <options>
        <option value="0">Normal</option>
        <option value="1">Fault</option>
        <option value="2">Off normal</option>
        <option value="3">High limit</option>
        <option value="4">Low limit</option>
        <option value="5">Life safety</option>
      </options>
    </state>
  </channel-type>

  <channel-type id="reliability">
    <item-type>Number</item-type>
    <label>Reliability</label>
    <state>
      <options>
        <option value="0">No fault detected</option>
        <option value="1">No sensor</option>
        <option value="2">Over range</option>
        <option value="3">Under range</option>
        <option value="4">Open loop</option>
        <option value="5">Shorted loop</option>
        <option value="6">No output</option>
        <option value="7">Unreliable other</option>
        <option value="8">Process error</option>
        <option value="9">Multi-state fault</option>
        <option value="10">Configuration error</option>
        <option value="12">Communication failure</option>
        <option value="13">Member fault</option>
        <option value="14">Monitored object fault</option>
        <option value="15">Tripped</option>
        <option value="16">Lamp failure</option>
        <option value="17">Activation failure</option>
        <option value="18">Renew dhcp failure</option>
        <option value="19">Renew registration failure</option>
        <option value="20">Restart auto negotiation failure</option>
        <option value="21">Restart failure</option>
        <option value="22">Proprietary command failure</option>
        <option value="23">Faults listed</option>
        <option value="24">Referenced object fault</option>
      </options>
    </state>
  </channel-type>

  <channel-type id="writeableBoolean">
    <item-type>Switch</item-type>
    <label>Writeable boolean</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-write"></config-description-ref>
  </channel-type>

  <channel-type id="writeableBinary">
    <item-type>Switch</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-write"></config-description-ref>
  </channel-type>

  <channel-type id="readableBinary">
    <item-type>Switch</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-only"></config-description-ref>
  </channel-type>

  <channel-type id="writeableNumber">
    <item-type>Number</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-write"></config-description-ref>
  </channel-type>

  <channel-type id="readableNumber">
    <item-type>Number</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-only"></config-description-ref>
  </channel-type>

  <channel-type id="writeableDateTime">
    <item-type>DateTime</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-write"></config-description-ref>
  </channel-type>

  <channel-type id="readableDateTime">
    <item-type>DateTime</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-only"></config-description-ref>
  </channel-type>

  <channel-type id="writeableText">
    <item-type>Text</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-write"></config-description-ref>
  </channel-type>

  <channel-type id="readableText">
    <item-type>Text</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:read-only"></config-description-ref>
  </channel-type>

  <!-- channels defined at -->

  <channel-type id="deviceWriteableBoolean">
    <item-type>Switch</item-type>
    <label>Writeable boolean</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableBinary">
    <item-type>Switch</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableBinary">
    <item-type>Switch</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableNumber">
    <item-type>Number</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableNumber">
    <item-type>Number</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableStatusFlags">
    <item-type>Number</item-type>
    <label>Status flags</label>
    <description>BACnet Status_Flags bitmask: 1 In Alarm, 2 Fault, 4 Overridden, 8 Out of Service.</description>
    <state>
      <options>
        <option value="0">Normal</option>
        <option value="1">In Alarm</option>
        <option value="2">Fault</option>
        <option value="3">In Alarm + Fault</option>
        <option value="4">Overridden</option>
        <option value="5">In Alarm + Overridden</option>
        <option value="6">Fault + Overridden</option>
        <option value="7">In Alarm + Fault + Overridden</option>
        <option value="8">Out of Service</option>
        <option value="9">In Alarm + Out of Service</option>
        <option value="10">Fault + Out of Service</option>
        <option value="11">In Alarm + Fault + Out of Service</option>
        <option value="12">Overridden + Out of Service</option>
        <option value="13">In Alarm + Overridden + Out of Service</option>
        <option value="14">Fault + Overridden + Out of Service</option>
        <option value="15">In Alarm + Fault + Overridden + Out of Service</option>
      </options>
    </state>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableEventState">
    <item-type>Number</item-type>
    <label>Event state</label>
    <description>BACnet Event_State enumeration: 0 Normal, 1 Fault, 2 Off Normal, 3 High Limit, 4 Low Limit, 5 Life Safety Alarm.</description>
    <state>
      <options>
        <option value="0">Normal</option>
        <option value="1">Fault</option>
        <option value="2">Off Normal</option>
        <option value="3">High Limit</option>
        <option value="4">Low Limit</option>
        <option value="5">Life Safety Alarm</option>
      </options>
    </state>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableOutOfService">
    <item-type>Switch</item-type>
    <label>Out of service</label>
    <description>BACnet Out_Of_Service property.</description>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableDateTime">
    <item-type>DateTime</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableDateTime">
    <item-type>DateTime</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableText">
    <item-type>Text</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceReadableText">
    <item-type>Text</item-type>
    <label>Present value</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-only"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableCalendar">
    <item-type>Calendar</item-type>
    <label>Calendar with series of entries</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

  <channel-type id="deviceWriteableWeekSchedule">
    <item-type>WeeklySchedule</item-type>
    <label>A week spanning schedule</label>
    <config-description-ref uri="thing-type:co7io-bacnet:device-read-write"></config-description-ref>
  </channel-type>

</thing:thing-descriptions>
